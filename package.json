{
  "name": "cue",
  "version": "0.1.0",
  "description": "Open-source macOS invisible AI overlay — three separate inputs (screen, mic, system audio) into an LLM. A Cluely-style copilot for meetings and coding problems.",
  "license": "GPL-3.0-or-later",
  "author": "cue",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac zip",
    "dist:win": "electron-builder --win",
    "stt:setup": "node scripts/stt-cli.js setup",
    "stt:status": "node scripts/stt-cli.js status",
    "stt:models": "node scripts/stt-cli.js models",
    "stt:download": "node scripts/stt-cli.js download",
    "stt:delete": "node scripts/stt-cli.js delete",
    "stt:test-providers": "node scripts/stt-test-providers.js"
  },
  "build": {
    "appId": "com.cue.overlay",
    "productName": "cue",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "python/**/*"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "cue transcribes your microphone so it can help you in conversations.",
        "NSCameraUsageDescription": "cue does not use the camera.",
        "NSAudioCaptureUsageDescription": "cue captures system audio to transcribe the other participant in a call."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "keywords": [
    "electron",
    "overlay",
    "ai",
    "assistant",
    "screencapturekit",
    "macos"
  ],
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^0.3.0",
    "electron": "^43.2.0",
    "lucide-static": "^0.468.0",
    "openai": "^4.73.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0"
  }
}
