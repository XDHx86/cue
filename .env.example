# cue .env example — copy to .env (or userData/.env) and edit. Dev-only; NOT shipped in
# the packaged build (package.json `files` allowlist excludes the repo root) and NOT committed
# with real keys. Shell-set environment variables ALWAYS take precedence over this file.
#
# Resolution order (first existing file wins): CUE_ENV_PATH → userData/.env → cwd/.env
# Set CUE_ENV_PATH=/absolute/path/to/.env to point elsewhere. All overrides are RUNTIME-ONLY —
# they are never written back to cue-data.json, so Settings never persists your env-supplied key.

# ---- Provider API keys (sets the matching Settings key without persisting it) ----
CUE_OPENAI_API_KEY=
CUE_ANTHROPIC_API_KEY=
CUE_GEMINI_API_KEY=
CUE_NVIDIA_API_KEY=
CUE_DEEPGRAM_API_KEY=

# ---- Ollama (local models; commit 8) ----
# Base URL of your `ollama serve` instance. cue talks to it via the OpenAI-compatible /v1.
CUE_OLLAMA_API_KEY=
CUE_OLLAMA_BASE_URL=http://localhost:11434

# ---- Speech-to-text (commits 9) ----
# 'auto' picks faster-whisper if its URL is set, else Deepgram if a key exists, else batch.
CUE_STT_PROVIDER=auto
CUE_FASTER_WHISPER_URL=ws://localhost:9080
CUE_DEEPGRAM_URL=wss://api.deepgram.com/v1/listen

# ---- Debug ----
# Set to 1 to log how many vars cue loaded from .env on startup.
# CUE_ENV_DEBUG=1
# Set to 1 to disable content protection for screenshots/debugging (see CLAUDE.md).
# CUE_NO_PROTECT=1
